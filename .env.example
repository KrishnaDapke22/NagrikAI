# NagrikAI Environment Configuration

# Application
APP_ENV=development
APP_NAME=NagrikAI
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database
# Use SQLite for local development out of the box, or PostgreSQL for production:
DATABASE_URL=sqlite:///./nagrikai.db
# DATABASE_URL=postgresql://nagrikai_user:nagrikai_secret@localhost:5432/nagrikai_db

# Security & JWT
JWT_SECRET=nagrikai_development_jwt_secret_key_32bytes_min!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / ML Service Configuration
SIMILARITY_THRESHOLD=0.75
CONFIDENCE_THRESHOLD=0.60
MODEL_DIR=./models

# Generative AI Provider: 'local', 'gemini', or 'openai'
LLM_PROVIDER=local
GEMINI_API_KEY=
OPENAI_API_KEY=

# Geocoding Service Configuration
GEOCODING_PROVIDER=nominatim
GEOCODING_USER_AGENT=NagrikAI-GrievancePlatform
GEOCODING_API_KEY=

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
